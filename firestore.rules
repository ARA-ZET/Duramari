rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The only document ever written: a small per-user profile (display
    // name, email, last sign-in). Budget data lives on each user's own
    // Google Drive, in a hidden folder only this app can read — never here.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The sample budget behind the signed-out tour. Readable by anyone,
    // because the tour runs before anyone has signed in; never writable from
    // a client — it is published with `scripts/publish-demo.mjs`. Contains
    // invented figures only.
    match /demo/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
